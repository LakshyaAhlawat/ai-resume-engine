# Database & Auth
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/your-db-name
NEXTAUTH_SECRET=generate-a-strong-secret-here
NEXTAUTH_URL=http://localhost:3000

# AI Providers
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# File Storage (Vercel Blob — free tier, create a store in your Vercel project dashboard)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# OAuth Login (optional — leave blank to disable that provider)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_SECRET=your_api_secret
GITHUB_TOKEN=
